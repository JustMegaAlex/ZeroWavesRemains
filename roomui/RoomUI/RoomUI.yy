    {"$GMRUILayer":"v1","%Name":"ui_text","alignItems":2,"children":[
        {"$GMRTextItem":"v3","%Name":"text_2D803F76","alignment":0,"charSpacing":0.0,"colour":4293132080,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"fontId":{"name":"Font1","path":"fonts/Font1/Font1.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_2D803F76","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.69,"scaleY":1.69,"text":"How to interact with items and shop:\n\n     1. Fly close to an item/shop\n     2. See it being highlighted\n     3. Press F to interact\n","wrap":false,"x":908.525,"y":56.0,},
        {"$GMRTextItem":"v3","%Name":"text_6AC12DA4","alignment":0,"charSpacing":0.0,"colour":4293132080,"flexProperties":{"$InstanceFlexProps":"v1","anchor":0,"resourceType":"InstanceFlexProps",},"fontId":{"name":"Font1","path":"fonts/Font1/Font1.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_6AC12DA4","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":1.622807,"scaleY":1.622807,"text":"Controls:\n\n     WASD - move\n\n     Left mouse - shoot\n\n     Right mouse - boost\n\n     Scroll mouse - change zoom\n\n     Q/E - switch weapon\n\n     1...3 - also switch weapon\n\n     P - pause/unpause\n\n     F - choose/interact with items and shop\n\n","wrap":false,"x":72.0,"y":56.0,},
      ],"flexDirection":0,"gridX":32,"gridY":32,"justifyContent":1,"name":"ui_text","nodeColour":4282970817,"resourceType":"GMRUILayer","resourceVersion":"2.0","visible":false,},
